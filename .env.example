# ─────────────────────────────────────────────────────────────
# SmartDukaan — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SmartDukaan

# ── Database (MongoDB Atlas) ─────────────────────────────────
# Free tier: M0, 512 MB limit
# Get connection string: Atlas → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartdukaan?retryWrites=true&w=majority

# ── Auth.js (NextAuth v5) ─────────────────────────────────────
# Generate AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=your-super-secret-key-min-32-chars

# Google OAuth — https://console.developers.google.com/
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# ── Cloudinary (Image Hosting) ────────────────────────────────
# https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ── Upstash Redis (Rate Limiting) ─────────────────────────────
# https://console.upstash.com/ → Create database → REST API
# Required in production — app logs a FATAL warning if missing
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── SMTP (Nodemailer — Transactional Email) ───────────────────
# Any SMTP provider works: Gmail, Zoho, Brevo, SES, etc.
# Gmail: enable 2FA → Google Account → App Passwords → generate 16-char password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password

# Admin alert email (demo requests, system notifications)
# Falls back to SMTP_USER if not set
ADMIN_EMAIL=admin@yourdomain.com

# ── Cron Jobs ────────────────────────────────────────────────
# Protects /api/cron/* routes from unauthorized invocations
# Generate: openssl rand -hex 32
# Set the same value in Vercel → Project → Settings → Cron Jobs
CRON_SECRET=your-cron-secret-min-32-chars

# ── Razorpay (Payments — Optional) ────────────────────────────
# https://dashboard.razorpay.com/ → Settings → API Keys
# Use rzp_test_* keys for development, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key

